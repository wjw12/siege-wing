# secrets
.env
.env.*

# python
__pycache__/
*.pyc

# build / dev output (release zips are attached to GitHub Releases)
release/
shots/

# large source assets: shipped as SiegeWing-source-assets zip on GitHub Releases
assets/audio/_src/
tools/blender/preview/

# duplicate checkpoints of tools/blender
tools/blender_ckpt/
tools/blender_ext/

# OS / editor
.DS_Store
Thumbs.db
desktop.ini
*.Zone.Identifier

# Blender backup copies made during iteration (the committed *_prev* files predate this rule)
assets/models/*_prev*.glb
tools/blender/*_prev*.py
